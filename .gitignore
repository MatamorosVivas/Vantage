# --- DEPENDENCIES ---
# Ignores all node_modules folders in the entire project
node_modules/
**/node_modules/
jspm_packages/
.npm
.eslintcache

# --- SECURITY ---
# Never upload secrets or environment variables
.env
.env.local
.env.*
!.env.example

# --- BUILD & OUTPUT ---
# Ignores the compiled production code
dist/
dist-ssr/
out/
build/
.next
.nuxt
.svelte-kit/
.temp
.cache

# --- LOGS ---
# Ignores error and debug logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- OS & EDITORS ---
# Ignores system-generated and editor-specific files
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
Thumbs.db

# --- VITE SPECIFIC ---
# Ignores temporary Vite files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*